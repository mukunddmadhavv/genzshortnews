{
  "name": "genz-news-studio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "npm run start -w @genz/server",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "db:migrate": "npm run migrate -w @genz/db",
    "access": "node apps/server/src/access.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2"
}
